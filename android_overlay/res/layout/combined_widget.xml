<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:background="@drawable/widget_background">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_wifi_usage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:includeFontPadding="false"
            android:text="—" android:textColor="#FFFFFF" android:textStyle="bold"
            android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_wifi_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:includeFontPadding="false"
            android:text="@string/widget_wifi_label" android:textColor="#BCE9E1"
            android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/widget_mobile_usage"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:includeFontPadding="false"
            android:text="—" android:textColor="#FFFFFF" android:textStyle="bold"
            android:textSize="15sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_mobile_title"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:includeFontPadding="false"
            android:text="@string/widget_mobile_label" android:textColor="#FFC584"
            android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
